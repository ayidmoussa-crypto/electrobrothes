// ElectroBrothers — catalog, cash-on-delivery orders, admin.
// Money is stored as whole Moroccan dirhams (Int, MAD).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  image         String?
  // Pictures on the category page's banner, chosen by the owner (up to 3). Empty: three of its products.
  bannerImages  String[]  @default([])
  sortOrder     Int       @default(0)
  products      Product[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  logo     String?
  products Product[]
}

model Product {
  id                String           @id @default(cuid())
  slug              String           @unique
  nameAr            String
  nameEn            String
  descriptionAr     String
  descriptionEn     String
  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id])
  brandId           String
  brand             Brand            @relation(fields: [brandId], references: [id])
  warrantyMonths    Int              @default(12)
  isActive          Boolean          @default(true)
  isFeatured        Boolean          @default(false)
  isBestSeller      Boolean          @default(false)
  // Limited-time offer: shown with a countdown until this date.
  dealEndsAt        DateTime?
  // Purchase price (MAD), admin only: never selected for the storefront. A colour may override it.
  costPrice         Int?
  // Search result texts; the name and description are used when empty.
  metaTitleAr       String?
  metaTitleEn       String?
  metaDescriptionAr String?
  metaDescriptionEn String?
  highlightsAr      String[]
  highlightsEn      String[]
  // Search phrase each language's content is written for: suggested by Claude, editable by the owner.
  focusKeywordAr    String?
  focusKeywordEn    String?
  // Rule-based SEO results, saved so lists stay fast: see lib/seo-content/score.ts.
  seoScore          Int              @default(0)
  seoScoreAr        Int              @default(0)
  seoScoreEn        Int              @default(0)
  seoProblems       Int              @default(0)
  seoDuplicateTitle Boolean          @default(false)
  seoScoredAt       DateTime?
  images            ProductImage[]
  variants          Variant[]
  specs             Spec[]
  reviews           Review[]
  stockMovements    StockMovement[]
  giveaways         Giveaway[]
  faqs              ProductFaq[]
  seoSuggestions    SeoSuggestion[]
  slugRedirects     SlugRedirect[]
  bundleItems       BundleItem[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  externalRatings   ExternalRating[]
  heroIn            Settings[]
  landingPage       LandingPage?
  offers            Offer[]

  @@index([categoryId, isActive])
  @@index([brandId])
  @@index([isActive, seoScore])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altAr     String
  altEn     String
  sortOrder Int     @default(0)

  @@index([productId])
}

// A purchasable option — in practice one colour (optionally with a capacity) — with its own price
// and stock. A product without colours has a single variant with no colour. Product stock = sum.
model Variant {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String          @unique
  colorAr        String?
  colorEn        String?
  // Product swatch colour (catalog data, not a UI colour).
  colorHex       String?
  storage        String?
  price          Int
  compareAtPrice Int?
  stock          Int             @default(0)
  // Purchase price for this colour when it differs from the product's (admin only).
  costPrice      Int?
  // Low-stock alert on the dashboard at or below this quantity.
  lowStockAt     Int             @default(3)
  isDefault      Boolean         @default(false)
  sortOrder      Int             @default(0)
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([productId])
}

enum StockReason {
  OPENING // quantity that existed before the log started
  STOCK_IN // added from the product editor (purchase / restock)
  ADJUSTMENT // removed or corrected from the product editor, or a colour deleted with stock left
  ORDER_CONFIRMED
  ORDER_CANCELLED
  ORDER_RETURNED
}

// Inventory ledger, one row per quantity change of a colour. Snapshots (sku, colour, cost) keep the
// history readable after the catalog changes; sum(delta) per variant equals its stock.
model StockMovement {
  id          String      @id @default(cuid())
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     Variant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  colorLabel  String?
  delta       Int
  // Stock of the colour right after this move.
  stockAfter  Int
  reason      StockReason
  // Purchase price per unit at that moment (variant override, else product), MAD.
  unitCost    Int?
  orderId     String?
  orderNumber String?
  // Admin email, or "system".
  actor       String
  note        String?
  createdAt   DateTime    @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([createdAt])
}

model ProductFaq {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  questionAr String
  answerAr   String
  questionEn String
  answerEn   String
  sortOrder  Int     @default(0)

  @@index([productId])
}

// An old product address, so links and search results keep working after a slug change.
model SlugRedirect {
  slug      String  @id
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Technical specification row. `key` is a stable id (ram, storage, screen, cpu…)
// whose label comes from i18n; `numericValue` powers range filters.
model Spec {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key          String
  valueAr      String
  valueEn      String
  numericValue Float?
  sortOrder    Int     @default(0)

  @@index([productId])
  @@index([key, numericValue])
}

model Review {
  id             String     @id @default(cuid())
  productId      String
  product        Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName     String
  city           String?
  rating         Int
  comment        String
  isApproved     Boolean    @default(true)
  createdAt      DateTime   @default(now())
  // Set when a customer reviews a delivered order. Only these are shown and counted in aggregateRating.
  orderItemId    String?    @unique
  orderItem      OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  verified       Boolean    @default(false)
  photoUrl       String?
  locale         String?
  rejectedAt     DateTime?
  decidedBy      String?
  // Written by Claude, never shown until the owner publishes it as replyText.
  suggestedReply String?
  replyText      String?

  @@index([productId, isApproved])
  @@index([isApproved, rejectedAt, createdAt])
}

enum ExternalRatingStatus {
  PENDING
  APPROVED
  REJECTED
}

// A rating published on another website, for this exact model. Never counted in structured data.
model ExternalRating {
  id            String               @id @default(cuid())
  productId     String
  product       Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  source        String
  url           String
  rating        Float
  ratingMax     Float                @default(5)
  ratingCount   Int?
  // Our own words, never the reviewers'.
  summaryAr     String?
  summaryEn     String?
  status        ExternalRatingStatus @default(PENDING)
  lastCheckedAt DateTime
  suggestedByAi Boolean              @default(false)
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime             @default(now())

  @@unique([productId, url])
  @@index([status, lastCheckedAt])
}

// One product's landing page (/offers/<slug>), built from a template in code (lib/landing.ts). Texts only: prices,
// stock, photos and dates always come from the product. The owner edits the draft; "نشر" copies it to `published`,
// which is the only thing shoppers see.
model LandingPage {
  id          String    @id @default(cuid())
  productId   String    @unique
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Key from lib/landing.ts TEMPLATES.
  template    String    @default("dark_premium")
  // [{ key, hidden }] for the middle sections; the hero is always first and the order form always last.
  sections    Json
  // { headline, subline, features, comparison, faq }
  content     Json
  // The Claude model that last wrote the draft's texts; null when written by hand or from the product's own data.
  model       String?
  // { template, sections, content } as published. Null: not live.
  published   Json?
  publishedAt DateTime?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// One offer of the week at the top of the home page (Campaign Studio). Several published ones are swiped through.
// Price and stock come from the product; the photo is one of the shop's own (a product photo or a campaign
// photo uploaded to Cloudinary).
model Offer {
  id          String          @id @default(cuid())
  // For the admin list only.
  name        String
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Key from lib/offers.ts OFFER_STYLES.
  style       String          @default("dark")
  titleAr     String
  titleEn     String          @default("")
  sublineAr   String          @default("")
  sublineEn   String          @default("")
  // Empty: the product's first photo.
  image       String?
  // "product": the product page; "page": its offer page (/offers/<slug>), when published.
  link        String          @default("product")
  // Shown and counted only between these dates. endsAt is the real end shown to shoppers ("ينتهي ...").
  startsAt    DateTime?
  endsAt      DateTime?
  isPublished Boolean         @default(false)
  sortOrder   Int             @default(0)
  // The Claude model that last wrote the title; null when typed by hand.
  model       String?
  updatedBy   String?
  events      CampaignEvent[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isPublished, sortOrder])
}

// One click on a home offer or an offer page (lib/campaign-events.ts). No personal data: no IP, no cookie id.
model CampaignEvent {
  id        String   @id @default(cuid())
  // hero_cta_click, whatsapp_click, order_form_submit
  type      String
  // "home" (offer banner) or "page" (offer page)
  source    String
  offerId   String?
  offer     Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)
  productId String?
  // Banner style or page template at the time of the click.
  template  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([offerId, type])
  @@index([productId, type])
}

// ───────────────────────── Delivery & settings ─────────────────────────

model City {
  id           String  @id @default(cuid())
  nameAr       String
  nameEn       String  @unique
  shippingFee  Int
  deliveryDays String  @default("2-4")
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)
  orders       Order[]
}

// Single row (id = 1), editable from the admin.
model Settings {
  id                    Int     @id @default(1)
  freeShippingThreshold Int     @default(1000)
  whatsappNumber        String  @default("")
  notifyEmail           String  @default("")
  // Hard monthly ceiling for the admin assistant's Claude API calls, in US cents. 0 turns it off.
  assistantBudgetCents  Int     @default(500)
  // Generated content goes live with an undo button, except what needsApproval() keeps back.
  seoAutoApply          Boolean @default(true)
  // The shop's promises to customers. Generated text may only repeat these, word for word.
  deliveryTimeAr        String  @default("2 إلى 5 أيام")
  deliveryTimeEn        String  @default("2 to 5 days")
  replacementPolicyAr   String  @default("إلا وصلك المنتج فيه عطب، كنبدلوه ليك بمنتج جديد.")
  replacementPolicyEn   String  @default("If your product arrives defective, we replace it with a new one.")
  // The carrier's cut is not a setting: it is the city's delivery price, and a refused parcel costs nothing (lib/finance.ts).
  // Unused: a "product of the week" home hero, tried on 2026-11-16 and taken back at the owner's request. The columns
  // are empty and stay until the owner agrees to drop them.
  heroProductId         String?
  heroProduct           Product? @relation(fields: [heroProductId], references: [id], onDelete: SetNull)
  heroHeadlineAr        String?
  heroHeadlineEn        String?
  // Offer pages: from this price (MAD) the AI picks the "editorial" template (lib/landing.ts chooseTemplate).
  landingEditorialFrom  Int      @default(1500)
}

enum CouponType {
  PERCENT
  FIXED
}

// A pack: products sold together for one price (lib/bundles.ts). In the cart its products are ordinary
// lines; once all of them are there, the difference to `price` comes off the order.
model Bundle {
  id        String       @id @default(cuid())
  slug      String       @unique
  nameAr    String
  nameEn    String
  // One short selling line under the name.
  taglineAr String?
  taglineEn String?
  // Photo of the pack; without one the products' own photos are shown side by side.
  image     String?
  // What the whole pack costs, MAD.
  price     Int
  isActive  Boolean      @default(true)
  sortOrder Int          @default(0)
  items     BundleItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([isActive, sortOrder])
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  sortOrder Int     @default(0)

  @@unique([bundleId, productId])
  @@index([productId])
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Int
  minSubtotal Int?
  maxUses     Int?
  usedCount   Int        @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
}

// ───────────────────────── Orders (cash on delivery) ─────────────────────────

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPING
  DELIVERED
  // Refused or sent back: the parcel is on its way back to the shop, the goods are not in stock yet.
  RETURNING
  RETURNED
  CANCELLED
}

enum OrderSource {
  WEBSITE
  WHATSAPP
  PHONE
  INSTAGRAM
  FACEBOOK
  TIKTOK
  OTHER
}

model Order {
  id                String           @id @default(cuid())
  number            String           @unique
  status            OrderStatus      @default(NEW)
  // Where the order came from; everything but WEBSITE was typed in by an admin.
  source            OrderSource      @default(WEBSITE)
  // Where the buyer came from (lib/attribution.ts): INSTAGRAM, SEO, META_ADS... Null on orders from before tracking.
  channel           String?
  // The ad campaign or referring site, when known.
  channelDetail     String?
  // Campaign Studio: the home offer clicked before ordering (cookie, 7 days), and the offer page template when the
  // order came from an offer page's form. Plain ids, no relation: the offer may be deleted, the figure stays.
  offerId           String?
  landingTemplate   String?
  // Shipment: filled in by an admin today, by the carrier's API once it is connected.
  carrier           String?
  trackingNumber    String?
  // Latest key from lib/carrier/status.ts.
  carrierStatus     String?
  // What the carrier actually charged for this parcel (delivery or return), MAD.
  carrierFee        Int?
  deliveredAt       DateTime?
  returnedAt        DateTime?
  // The owner opened WhatsApp with the confirmation message: a NEW order then waits for the reply.
  confirmSentAt     DateTime?
  // Someone opened WhatsApp with the review request for this delivered order (sent by hand). First send only.
  reviewAskedAt     DateTime?
  // Who took the order out of NEW (confirmed or cancelled it), when, and to what: an agent's figures.
  handledById       String?
  handledBy         AdminUser?       @relation(fields: [handledById], references: [id], onDelete: SetNull)
  handledAt         DateTime?
  handledAs         OrderStatus?
  // Paid before shipping (bank transfer...): the carrier collects 0 at the door. Null = cash on delivery.
  prepaidAt         DateTime?
  // Cash the carrier really handed over for this order. Null = not received yet.
  codReceivedAt     DateTime?
  codReceivedAmount Int?
  events            ShipmentEvent[]
  customerName      String
  // Normalized E.164, e.g. +212612345678
  phone             String
  cityId            String
  city              City             @relation(fields: [cityId], references: [id])
  cityName          String
  address           String
  notes             String?
  subtotal          Int
  shippingFee       Int
  // Everything taken off the goods: pack savings + coupon. bundleDiscount is the pack part of it.
  discount          Int              @default(0)
  bundleDiscount    Int              @default(0)
  total             Int
  couponCode        String?
  // Anti-fraud: 0 = clean; flags explain the score (duplicate_phone, too_fast…).
  riskScore         Int              @default(0)
  riskFlags         String[]
  // Stock is taken on CONFIRMED and given back on CANCELLED/RETURNED; this keeps it idempotent.
  stockDeducted     Boolean          @default(false)
  ip                String?
  userAgent         String?
  items             OrderItem[]
  logs              OrderStatusLog[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([phone, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([trackingNumber])
  @@index([status, deliveredAt])
  @@index([status, returnedAt])
  @@index([handledById, handledAt])
  @@index([offerId])
  @@index([landingTemplate])
}

// A delivery company the shop works with (Settings → Delivery companies). It pushes parcel updates to its own
// webhook address (/api/webhooks/carrier/<webhookToken>); its own status names are mapped onto lib/carrier/status.ts.
model Carrier {
  id            String    @id @default(cuid())
  name          String
  // Shown next to each order sent with this company (orders list). Null: its initials show instead.
  logoUrl       String?
  // The carrier's public tracking page; "{tracking}" is replaced by the parcel number.
  trackingUrl   String?
  apiBaseUrl    String?
  // API key, login and password, encrypted (lib/carrier/secrets.ts). Never sent back to the browser.
  credentials   String?
  webhookToken  String    @unique
  // Where the tracking number, status and note sit in the carrier's JSON ("data.status").
  trackingField String    @default("tracking")
  statusField   String    @default("status")
  noteField     String?
  // The carrier's status text (lower case) → a CarrierStatus key.
  statusMap     Json      @default("{}")
  isActive      Boolean   @default(true)
  // Picked first on a new shipment.
  isDefault     Boolean   @default(false)
  lastEventAt   DateTime?
  // Status texts received that are not mapped yet, newest first, so the owner can map them.
  unknownStatuses String[]
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// One step of a parcel's journey, newest shown first.
model ShipmentEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Key from lib/carrier/status.ts.
  status     String
  note       String?
  actor      String
  occurredAt DateTime @default(now())

  @@index([orderId, occurredAt])
}

// Snapshot of what was bought, so later catalog edits never rewrite history.
model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku          String
  nameAr       String
  nameEn       String
  variantLabel String?
  unitPrice    Int
  // Purchase price per unit when ordered, so profit never moves when a cost changes later. Null = unknown.
  unitCost     Int?
  quantity     Int
  review       Review?

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusLog {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  // Admin email, or "system" / "customer".
  actor      String
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model Blacklist {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// Shoppers who left their email in the home page box. Listed in /admin/customers.
model EmailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("ar")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ───────────────────────── Giveaways ─────────────────────────

// A prize drawn live (Instagram / TikTok): people enter on the shop, entries close at drawAt, the owner
// draws from the dashboard in front of the live audience.
model Giveaway {
  id            String          @id @default(cuid())
  slug          String          @unique
  titleAr       String
  titleEn       String
  prizeAr       String
  prizeEn       String
  // Short rules or story; the shop adds the standard rules under it.
  detailsAr     String?
  detailsEn     String?
  // The prize's own photo; the linked product's first photo when empty.
  image         String?
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Prize value in MAD, shown as "worth".
  prizeValue    Int?
  drawAt        DateTime
  // Where the live is watched (Instagram / TikTok profile or live link).
  liveUrl       String?
  isPublished   Boolean         @default(false)
  // Set by the first draw: entries close for good.
  drawnAt       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  entries       GiveawayEntry[]

  @@index([isPublished, drawAt])
}

model GiveawayEntry {
  id          String   @id @default(cuid())
  giveawayId  String
  giveaway    Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  // E.164, one entry per number and giveaway.
  phone       String
  // Agreed to hear about offers on WhatsApp (optional box).
  marketing   Boolean  @default(false)
  ip          String?
  // 1 = winner, 2+ = backups drawn after; null = not drawn.
  winnerRank  Int?
  drawnAt     DateTime?
  createdAt   DateTime @default(now())

  @@unique([giveawayId, phone])
  @@index([giveawayId, winnerRank])
}

// ───────────────────────── Finance ─────────────────────────

enum ExpenseScope {
  BUSINESS
  PERSONAL
}

// Money that left the owner's pocket. PERSONAL never touches the shop's profit, but it does reduce the cash.
model Expense {
  id        String       @id @default(cuid())
  scope     ExpenseScope @default(BUSINESS)
  // Key from lib/finance.ts.
  category  String
  amount    Int
  spentOn   DateTime
  note      String?
  actor     String
  createdAt DateTime     @default(now())

  @@index([scope, spentOn])
}

enum CapitalType {
  INJECTION
  WITHDRAWAL
}

// Money the owner put into the business or took out of it.
model CapitalEntry {
  id         String      @id @default(cuid())
  type       CapitalType
  amount     Int
  occurredOn DateTime
  note       String?
  actor      String
  createdAt  DateTime    @default(now())

  @@index([occurredOn])
}

// ───────────────────────── WhatsApp ─────────────────────────

enum WaDirection {
  IN
  OUT
}

model WaConversation {
  id            String      @id @default(cuid())
  // "+" and digits, as WhatsApp gives it. May be foreign: only orders are limited to Moroccan numbers.
  phone         String      @unique
  name          String?
  lastMessageAt DateTime    @default(now())
  // Free text is only allowed within 24 hours of this; after that, approved templates only.
  lastInboundAt DateTime?
  lastPreview   String?
  unread        Int         @default(0)
  messages      WaMessage[]
  createdAt     DateTime    @default(now())

  @@index([lastMessageAt])
}

model WaMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Meta's id; unique, because Meta re-sends webhooks.
  wamid          String?        @unique
  direction      WaDirection
  type           String         @default("text")
  body           String
  templateName   String?
  // sent, delivered, read or failed (outgoing only).
  status         String?
  error          String?
  // Admin email, or "automation".
  actor          String?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// ───────────────────────── Automations ─────────────────────────

// When an order reaches `trigger`, wait `delayMinutes`, then send an approved WhatsApp template.
model AutomationRule {
  id           String          @id @default(cuid())
  name         String
  // Key from lib/automation-rules.ts.
  trigger      String
  delayMinutes Int             @default(0)
  templateName String
  languageCode String          @default("ar")
  // Keys of the values that fill the template's {{1}}, {{2}}… in order.
  params       String[]
  // Off until the owner has an approved template and switches it on.
  isActive     Boolean         @default(false)
  jobs         AutomationJob[]
  createdAt    DateTime        @default(now())

  @@index([trigger, isActive])
}

enum AutomationJobStatus {
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
}

model AutomationJob {
  id        String              @id @default(cuid())
  ruleId    String
  rule      AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  orderId   String
  status    AutomationJobStatus @default(PENDING)
  dueAt     DateTime
  attempts  Int                 @default(0)
  error     String?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  // One message per rule per order, even if the order goes back and forth between statuses.
  @@unique([ruleId, orderId])
  @@index([status, dueAt])
  @@index([createdAt])
}

// Fixed-window counter keyed by e.g. "order:ip:1.2.3.4".
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// What happened around sign-ins and the back office: failed and good logins, blocked attempts, wrong
// two-step codes, password changes, an agent trying an owner page, admin visits. Never a password.
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  email     String?
  userId    String?
  ip        String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ───────────────────────── Admin ─────────────────────────

enum AdminRole {
  // The owner: the whole panel.
  OWNER
  // Confirmation staff: orders and messages only, plus their own figures (/admin/me).
  AGENT
}

model AdminUser {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  role            AdminRole @default(OWNER)
  // Off: the account can no longer sign in, but its history and figures stay.
  isActive        Boolean   @default(true)
  // What an agent earns, MAD: per order they confirmed, and per one of those that was delivered.
  payPerConfirmed Int       @default(0)
  payPerDelivered Int       @default(0)
  lastLoginAt     DateTime?
  // Two-step login (owner, optional). The authenticator key, AES-GCM sealed (lib/totp.ts), never plain.
  // Set with no totpEnabledAt = a setup started but not confirmed with a correct code yet.
  totpSecret      String?
  totpEnabledAt   DateTime?
  // Time step of the last code accepted: a code works once.
  totpLastStep    Int?
  // scrypt hashes of the unused backup codes; a used one is removed.
  totpBackupCodes String[]  @default([])
  handledOrders   Order[]
  createdAt       DateTime  @default(now())
}

// ───────────────────────── Admin assistant ─────────────────────────

enum AssistantActionKind {
  STOCK_CHANGE
  DRAFT_PRODUCT
  // Names, descriptions, prices, purchase price or new colours of an existing product.
  PRODUCT_UPDATE
}

enum AssistantActionStatus {
  PENDING
  APPLIED
  CANCELLED
  EXPIRED
  UNDONE
}

// Everything the assistant proposes. Nothing touches the catalog until an admin confirms the row.
model AssistantAction {
  id          String                @id @default(cuid())
  kind        AssistantActionKind
  status      AssistantActionStatus @default(PENDING)
  summary     String
  // The validated proposal, plus what the confirmation card shows.
  payload     Json
  // What undo needs; set when applied.
  undo        Json?
  // Base64 JPEG for a draft's Cloudinary upload; removed as soon as the proposal is decided.
  photo       String?
  model       String
  requestedBy String
  decidedBy   String?
  undoneBy    String?
  createdAt   DateTime              @default(now())
  decidedAt   DateTime?
  undoneAt    DateTime?

  @@index([status, createdAt])
  @@index([createdAt])
}

enum SeoSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
  UNDONE
}

// One proposed value for one field of a product, accepted or refused on its own. Nothing reaches the
// store while PENDING; oldValue is what undo restores.
model SeoSuggestion {
  id          String              @id @default(cuid())
  productId   String
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  field       String
  oldValue    Json?
  newValue    Json
  // A specification Claude could not confirm: shown as "خاص التحقق" and can never be applied.
  needsCheck  Boolean             @default(false)
  status      SeoSuggestionStatus @default(PENDING)
  autoApplied Boolean             @default(false)
  nightly     Boolean             @default(false)
  model       String
  requestedBy String
  decidedBy   String?
  undoneBy    String?
  createdAt   DateTime            @default(now())
  decidedAt   DateTime?
  undoneAt    DateTime?

  @@index([status, createdAt])
  @@index([productId, status])
}

// The shop's overall SEO result, one row per day, for the progress chart.
model SeoDailyScore {
  // "YYYY-MM-DD", Moroccan time.
  day      String @id
  score    Int
  products Int
  green    Int
  orange   Int
  red      Int
  problems Int
}

// One pass of the SEO job, nightly or from the "شغّل دابا" button.
model SeoRun {
  id          String    @id @default(cuid())
  trigger     String
  status      String    @default("RUNNING")
  examined    Int       @default(0)
  generated   Int       @default(0)
  failed      Int       @default(0)
  suggestions Int       @default(0)
  autoApplied Int       @default(0)
  // Why it ended early: budget, deadline, api_key.
  stoppedBy   String?
  actor       String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([startedAt])
}

// One row per Claude API call; the monthly counter and ceiling sum these.
model AssistantUsage {
  id               String   @id @default(cuid())
  // "YYYY-MM", Moroccan time.
  month            String
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costMicros       Int
  actor            String
  createdAt        DateTime @default(now())

  @@index([month])
}
