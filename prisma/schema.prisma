// ElectroBrothers — catalog, cash-on-delivery orders, admin.
// Money is stored as whole Moroccan dirhams (Int, MAD).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  image         String?
  sortOrder     Int       @default(0)
  products      Product[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  logo     String?
  products Product[]
}

model Product {
  id             String         @id @default(cuid())
  slug           String         @unique
  nameAr         String
  nameEn         String
  descriptionAr  String
  descriptionEn  String
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  brandId        String
  brand          Brand          @relation(fields: [brandId], references: [id])
  warrantyMonths Int            @default(12)
  isActive       Boolean        @default(true)
  isFeatured     Boolean        @default(false)
  isBestSeller   Boolean        @default(false)
  // Limited-time offer: shown with a countdown until this date.
  dealEndsAt     DateTime?
  // Purchase price (MAD), admin only: never selected for the storefront. A colour may override it.
  costPrice      Int?
  images         ProductImage[]
  variants       Variant[]
  specs          Spec[]
  reviews        Review[]
  stockMovements StockMovement[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId, isActive])
  @@index([brandId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altAr     String
  altEn     String
  sortOrder Int     @default(0)

  @@index([productId])
}

// A purchasable option — in practice one colour (optionally with a capacity) — with its own price
// and stock. A product without colours has a single variant with no colour. Product stock = sum.
model Variant {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String          @unique
  colorAr        String?
  colorEn        String?
  // Product swatch colour (catalog data, not a UI colour).
  colorHex       String?
  storage        String?
  price          Int
  compareAtPrice Int?
  stock          Int             @default(0)
  // Purchase price for this colour when it differs from the product's (admin only).
  costPrice      Int?
  // Low-stock alert on the dashboard at or below this quantity.
  lowStockAt     Int             @default(3)
  isDefault      Boolean         @default(false)
  sortOrder      Int             @default(0)
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([productId])
}

enum StockReason {
  OPENING // quantity that existed before the log started
  STOCK_IN // added from the product editor (purchase / restock)
  ADJUSTMENT // removed or corrected from the product editor, or a colour deleted with stock left
  ORDER_CONFIRMED
  ORDER_CANCELLED
  ORDER_RETURNED
}

// Inventory ledger, one row per quantity change of a colour. Snapshots (sku, colour, cost) keep the
// history readable after the catalog changes; sum(delta) per variant equals its stock.
model StockMovement {
  id          String      @id @default(cuid())
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     Variant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  colorLabel  String?
  delta       Int
  // Stock of the colour right after this move.
  stockAfter  Int
  reason      StockReason
  // Purchase price per unit at that moment (variant override, else product), MAD.
  unitCost    Int?
  orderId     String?
  orderNumber String?
  // Admin email, or "system".
  actor       String
  note        String?
  createdAt   DateTime    @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([createdAt])
}

// Technical specification row. `key` is a stable id (ram, storage, screen, cpu…)
// whose label comes from i18n; `numericValue` powers range filters.
model Spec {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key          String
  valueAr      String
  valueEn      String
  numericValue Float?
  sortOrder    Int     @default(0)

  @@index([productId])
  @@index([key, numericValue])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  city       String?
  rating     Int
  comment    String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([productId, isApproved])
}

// ───────────────────────── Delivery & settings ─────────────────────────

model City {
  id           String  @id @default(cuid())
  nameAr       String
  nameEn       String  @unique
  shippingFee  Int
  deliveryDays String  @default("2-4")
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)
  orders       Order[]
}

// Single row (id = 1), editable from the admin.
model Settings {
  id                    Int    @id @default(1)
  freeShippingThreshold Int    @default(1000)
  whatsappNumber        String @default("")
  notifyEmail           String @default("")
  // Hard monthly ceiling for the admin assistant's Claude API calls, in US cents. 0 turns it off.
  assistantBudgetCents  Int    @default(500)
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Int
  minSubtotal Int?
  maxUses     Int?
  usedCount   Int        @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
}

// ───────────────────────── Orders (cash on delivery) ─────────────────────────

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPING
  DELIVERED
  RETURNED
  CANCELLED
}

model Order {
  id            String           @id @default(cuid())
  number        String           @unique
  status        OrderStatus      @default(NEW)
  customerName  String
  // Normalized E.164, e.g. +212612345678
  phone         String
  cityId        String
  city          City             @relation(fields: [cityId], references: [id])
  cityName      String
  address       String
  notes         String?
  subtotal      Int
  shippingFee   Int
  discount      Int              @default(0)
  total         Int
  couponCode    String?
  // Anti-fraud: 0 = clean; flags explain the score (duplicate_phone, too_fast…).
  riskScore     Int              @default(0)
  riskFlags     String[]
  // Stock is taken on CONFIRMED and given back on CANCELLED/RETURNED; this keeps it idempotent.
  stockDeducted Boolean          @default(false)
  ip            String?
  userAgent     String?
  items         OrderItem[]
  logs          OrderStatusLog[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([phone, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

// Snapshot of what was bought, so later catalog edits never rewrite history.
model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku          String
  nameAr       String
  nameEn       String
  variantLabel String?
  unitPrice    Int
  quantity     Int

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusLog {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  // Admin email, or "system" / "customer".
  actor      String
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model Blacklist {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// Fixed-window counter keyed by e.g. "order:ip:1.2.3.4".
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// ───────────────────────── Admin ─────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

// ───────────────────────── Admin assistant ─────────────────────────

enum AssistantActionKind {
  STOCK_CHANGE
  DRAFT_PRODUCT
}

enum AssistantActionStatus {
  PENDING
  APPLIED
  CANCELLED
  EXPIRED
  UNDONE
}

// Everything the assistant proposes. Nothing touches the catalog until an admin confirms the row.
model AssistantAction {
  id          String                @id @default(cuid())
  kind        AssistantActionKind
  status      AssistantActionStatus @default(PENDING)
  summary     String
  // The validated proposal, plus what the confirmation card shows.
  payload     Json
  // What undo needs; set when applied.
  undo        Json?
  // Base64 JPEG for a draft's Cloudinary upload; removed as soon as the proposal is decided.
  photo       String?
  model       String
  requestedBy String
  decidedBy   String?
  undoneBy    String?
  createdAt   DateTime              @default(now())
  decidedAt   DateTime?
  undoneAt    DateTime?

  @@index([status, createdAt])
  @@index([createdAt])
}

// One row per Claude API call; the monthly counter and ceiling sum these.
model AssistantUsage {
  id               String   @id @default(cuid())
  // "YYYY-MM", Moroccan time.
  month            String
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costMicros       Int
  actor            String
  createdAt        DateTime @default(now())

  @@index([month])
}
