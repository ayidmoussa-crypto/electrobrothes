{
  "name": "electrobrothers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "setup": "prisma migrate deploy && prisma db seed",
    "build": "next build",
    "build:prod": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:summary": "tsx scripts/db-summary.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@neon/config": "^1.10.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "lucide-react": "^1.66.0",
    "motion": "^14.14.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "mupdf": "^1.28.1",
    "prisma": "^7.10.1",
    "simple-icons": "^16.36.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@swc/core@1.16.21": true
  }
}
