# ElectroBrothers — environment variables. Copy to .env and fill in. Never commit real values.

# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Written automatically to .env.local by `neon checkout <branch>` / `neon env pull`.
# Use sslmode=verify-full: the Neon CLI writes sslmode=require, which `pg` accepts but warns about
# (it already treats require as verify-full). Re-apply after each neon checkout / env pull.
# Pooled connection (host contains "-pooler"): used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"
# Direct connection (no "-pooler"): used by Prisma migrations and the seed.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"
# Branch name; the seed refuses to run on "production".
NEON_BRANCH=dev

# ── Admin sessions (required) ───────────────────────────────────────────────
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public address of the shop (used in emails to link to the admin), no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social links shown in the footer (full URLs). Leave empty to hide an icon.
# The WhatsApp icon uses the number set in the admin settings.
INSTAGRAM_URL=
FACEBOOK_URL=
TIKTOK_URL=

# ── New-order email notifications (SMTP) ────────────────────────────────────
# Any SMTP provider: Gmail (smtp.gmail.com, 587, an "app password"), Brevo (smtp-relay.brevo.com, 587)…
# The recipient is set in Admin → الإعدادات; NOTIFY_EMAIL is only a fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ElectroBrothers <orders@your-domain.ma>"
NOTIFY_EMAIL=

# ── Marketing pixels (optional; each one loads only if its ID is set) ───────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ── Cloudflare Turnstile (optional, free anti-bot on the order form) ────────
# Leave empty to disable. Get keys at https://dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Claude AI assistant (admin) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Nightly SEO job ──────────────────────────────────────────────────────────
# Shared secret of /api/cron/seo. Vercel sends it automatically; the job does not run without it.
CRON_SECRET=

# ── Express Relais delivery API ──────────────────────────────────────────────
# Dev (sandbox) endpoint; switch to the production URL when going live.
ER_BASE_URL=https://api-aio-dev.relaisexpress.ma
ER_LOGIN=
ER_PASSWORD=

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# From developers.facebook.com, your app → WhatsApp. Leave empty: the inbox shows a setup note and nothing is sent.
# Webhook address to give Meta: https://YOUR-DOMAIN/api/webhooks/whatsapp (field: messages).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Settings → Basic → App secret: proves a webhook call really comes from Meta.
WHATSAPP_APP_SECRET=
# Any long random text; type the same one into Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v27.0

# ── Cloudinary (optional, product photo uploads from the admin) ─────────────
# Leave empty to add images by URL instead. Free plan: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
